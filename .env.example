# Copy to .env (gitignored); make reads it and passes these to the servers it starts.
# These values are for running on your own machine only. The token is public, so anywhere else
# replace it with your own: openssl rand -hex 32
CKA_SIM_PLATFORM_ADDR=127.0.0.1:7070
CKA_SIM_LAB_URL=http://127.0.0.1:7171
CKA_SIM_CLUSTER=cka-sim
CKA_SIM_AGENT_TOKEN=local-only-agent-token-not-a-secret
# The token the platform and the assistant share; leave it out to turn TutorService and the tutor off.
CKA_SIM_ASSISTANT_TOKEN=local-only-assistant-token-not-a-secret
CKA_SIM_ASSISTANT_ADDR=127.0.0.1:7373
CKA_SIM_PLATFORM_URL=http://127.0.0.1:7070
# Where the platform finds the assistant for the page's tutor; leave it out to turn the tutor off.
CKA_SIM_ASSISTANT_URL=http://127.0.0.1:7373
# The GCP project whose Vertex AI (Gemini) answers the tutor, with your gcloud application-default login;
# leave it empty and the tutor says it has no AI.
CKA_SIM_VERTEX_PROJECT=
