# Copy to .env (gitignored); make reads it and passes these to the servers it starts.
# These values are for running on your own machine only. The token is public, so anywhere else
# replace it with your own: openssl rand -hex 32
CKA_SIM_PLATFORM_ADDR=127.0.0.1:7070
CKA_SIM_LAB_URL=http://127.0.0.1:7171
CKA_SIM_AGENT_TOKEN=local-only-agent-token-not-a-secret
