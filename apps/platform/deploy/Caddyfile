{$SITE_HOST} {
	handle /api/auth/* {
		reverse_proxy auth:7272
	}
	handle /mcp {
		reverse_proxy {$CKA_SIM_ASSISTANT_UPSTREAM:127.0.0.1:7373}
	}
	@backend path /api/* /ws/*
	handle @backend {
		reverse_proxy 127.0.0.1:7070
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
